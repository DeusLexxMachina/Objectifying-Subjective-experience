var dris=[{d:"DRI A",n:43,k:35},{d:"DRI B",n:14,k:10},{d:"DRI C",n:20,k:12},{d:"DRI D",n:24,k:14},{d:"DRI E",n:14,k:8},{d:"DRI F",n:13,k:7},{d:"DRI G",n:23,k:12},{d:"DRI H",n:32,k:10},{d:"DRI I",n:4,k:1}];
var refOther={n:126,k:92};
function drawForest(){
  var svg=document.getElementById("forest");clear(svg);
  var W=availW("forest"),narrow=W<560,x0=narrow?62:130,xw=W-x0-(narrow?46:90),sx=function(v){return x0+v*xw;},y0=44,rh=narrow?38:34;
  var yEnd=y0+(dris.length-1)*rh+20;svg.setAttribute("viewBox","0 0 "+W+" "+(yEnd+36));
  var team=dris.reduce(function(a,r){return a+r.k;},0)/dris.reduce(function(a,r){return a+r.n;},0);
  var other=refOther.k/refOther.n;
  [0,.25,.5,.75,1].forEach(function(t){el("line",{x1:sx(t),x2:sx(t),y1:y0-16,y2:yEnd,stroke:"var(--rule)"},svg);txt(svg,sx(t),yEnd+20,Math.round(t*100)+"%",{"text-anchor":"middle",fill:"var(--ink3)","font-size":"12"});});
  el("line",{x1:sx(team),x2:sx(team),y1:y0-22,y2:yEnd,stroke:"var(--ref)","stroke-dasharray":"4 3"},svg);
  txt(svg,sx(team)-6,y0-26,(narrow?"":"All nine DRIs: ")+Math.round(team*100)+"%",{"text-anchor":"end",fill:"var(--ink2)","font-size":"12"});
  el("line",{x1:sx(other),x2:sx(other),y1:y0-22,y2:yEnd,stroke:"var(--ref)","stroke-dasharray":"1 3"},svg);
  txt(svg,sx(other)+6,y0-26,(narrow?"":"Other participants: ")+Math.round(other*100)+"%",{fill:"var(--ink2)","font-size":"12"});
  dris.forEach(function(r,i){
    var y=y0+i*rh,ci=wilson(r.k,r.n),v=r.k/r.n;
    var g=el("g",{},svg);
    var hit=el("rect",{x:0,y:y-rh/2,width:W,height:rh,fill:"transparent"},g);
    if(narrow){txt(g,0,y,r.d,{fill:"var(--ink)","font-size":"13"});txt(g,0,y+14,"n="+r.n,{fill:"var(--ink3)","font-size":"11"});}
    else txt(g,0,y+4,r.d+"  (n="+r.n+")",{fill:"var(--ink)","font-size":"13"});
    el("line",{x1:sx(ci.lo),x2:sx(ci.hi),y1:y,y2:y,stroke:"var(--muted)","stroke-width":"3","stroke-linecap":"round"},g);
