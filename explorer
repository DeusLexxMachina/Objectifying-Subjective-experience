/* ---------- sizing ---------- */
function clear(svg){while(svg.firstChild)svg.removeChild(svg.firstChild);}
function availW(id){
  var mn=document.querySelector("main"),cs=getComputedStyle(mn),m=mn.clientWidth-parseFloat(cs.paddingLeft)-parseFloat(cs.paddingRight),w=m-42,svg=document.getElementById(id);
  if(svg.closest(".g2")&&innerWidth>820)w=(m-16)/2-42;
  return Math.max(290,Math.min(760,Math.round(w)));
}

