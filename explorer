function go(i,scroll){
  cur=Math.max(0,Math.min(panels.length-1,i));
  panels.forEach(function(p,j){p.classList.toggle("active",j===cur);});
  [].forEach.call(stepsEl.children,function(b,j){b.setAttribute("aria-current",j===cur?"true":"false");});
  stepsEl.children[cur].scrollIntoView({block:"nearest",inline:"center",behavior:"smooth"});
  bar.style.width=(cur/(panels.length-1)*100)+"%";
  if(history.replaceState)history.replaceState(null,"","#"+panels[cur].id);
  if(document.body.classList.contains("all")){panels[cur].scrollIntoView({behavior:"smooth"});}
  else if(scroll){window.scrollTo({top:document.querySelector("header.top").offsetHeight,behavior:"smooth"});}
}
document.addEventListener("keydown",function(e){
  if(e.target.closest&&e.target.closest("input,textarea"))return;
  if(e.key==="ArrowRight")go(cur+1,true);
  if(e.key==="ArrowLeft")go(cur-1,true);
});
