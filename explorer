var mixOp={"Resolved":1,"Partial answer":1,"Redirected":.7,"Acknowledged only":1,"No visible response":1};
function drawMix(){
  var svg=document.getElementById("mix");clear(svg);
  var W=availW("mix"),narrow=W<560,x0=narrow?0:170,BW=W-x0,rh=34,step=narrow?76:60;
  svg.setAttribute("viewBox","0 0 "+W+" "+(mixRows.length*step+4));
  mixRows.forEach(function(r,i){
    var y=(narrow?22:8)+i*step,x=x0;
    if(narrow)txt(svg,0,y-8,r.name,{fill:"var(--ink)","font-size":"14"});
    else txt(svg,0,y+rh/2+5,r.name,{fill:"var(--ink)","font-size":"14"});
    r.parts.forEach(function(p){
      var w=p[1]/r.n*BW;if(w<=0)return;
      var rc=el("rect",{x:x,y:y,width:Math.max(w-2,1),height:rh,rx:3,fill:mixCol[p[0]],"fill-opacity":mixOp[p[0]]},svg);
