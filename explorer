function drawFlow(){
  var svg=document.getElementById("flow");clear(svg);
  var W=availW("flow"),narrow=W<560,s=narrow?1.5:1.75,xL=narrow?0:150,nw=10,xR=narrow?70:380,y0=narrow?36:20,minSlot=38,gap=10,fs=narrow?12:14;
  var N=dests.reduce(function(a,r){return a+r.n;},0),K=dests.reduce(function(a,r){return a+r.k;},0);
  var y=y0,off=0;
  dests.forEach(function(r){r.h=r.n*s;r.y=y;r.slot=Math.max(r.h,minSlot)+gap;y+=r.slot;r.sy=y0+off;off+=r.h;});
  var H=Math.max(y,y0+N*s)+10;svg.setAttribute("viewBox","0 0 "+W+" "+H);
  var mx=(xL+nw+xR)/2,paths=[],detail=document.getElementById("flowDetail");
