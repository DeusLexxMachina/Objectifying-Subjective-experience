  b.innerHTML=(i?'<span class="n">'+i+'</span>':'')+p.dataset.title;
  b.addEventListener("click",function(){go(i,true);});
  stepsEl.appendChild(b);
  var pg=document.createElement("div");pg.className="pager";
  if(i>0){var pv=document.createElement("button");pv.type="button";pv.className="prev";pv.innerHTML="<small>Previous</small>"+panels[i-1].dataset.title;pv.addEventListener("click",function(){go(i-1,true);});pg.appendChild(pv);}
  if(i<panels.length-1){var nx=document.createElement("button");nx.type="button";nx.className="next";nx.innerHTML="<small>Next</small>"+panels[i+1].dataset.title;nx.addEventListener("click",function(){go(i+1,true);});pg.appendChild(nx);}
  p.appendChild(pg);
