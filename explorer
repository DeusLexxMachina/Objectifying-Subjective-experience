/* ---------- simple bar helper ---------- */
function bars(svgId,rows,opts){
  var svg=document.getElementById(svgId);clear(svg);
  var W=availW(svgId),narrow=W<560,x0=narrow?0:(opts.x0||210),xw=W-x0-52,rh=opts.rh||30,gapY=narrow?40:(opts.gap||18),y0=narrow?24:(opts.y0||12);
  svg.setAttribute("viewBox","0 0 "+W+" "+(y0+rows.length*(rh+gapY)-gapY+8));
  rows.forEach(function(r,i){
    var y=y0+i*(rh+gapY),v=r.k/r.n;
    if(narrow){var t=txt(svg,0,y-8,r.label,{fill:"var(--ink)","font-size":"13"});if(r.sub){var ts=document.createElementNS(NS,"tspan");ts.setAttribute("fill","var(--ink3)");ts.setAttribute("font-size","12");ts.textContent="  "+r.sub;t.appendChild(ts);}}
    else{txt(svg,0,y+rh/2-2,r.label,{fill:"var(--ink)","font-size":"13"});if(r.sub)txt(svg,0,y+rh/2+14,r.sub,{fill:"var(--ink3)","font-size":"12"});}
    el("rect",{x:x0,y:y,width:xw,height:rh,rx:4,fill:"var(--muted3)"},svg);
    var b=el("rect",{x:x0,y:y,width:Math.max(v*xw,2),height:rh,rx:4,fill:r.hi?"var(--accent)":"var(--muted)"},svg);
    bindTip(b,"<b>"+r.label+"</b><br>"+r.k+" of "+r.n+" resolved ("+pct(r.k,r.n)+")");
    txt(svg,x0+xw+8,y+rh/2+5,pct(r.k,r.n),{fill:"var(--ink)","font-size":"14","font-weight":"600"});
  });
}
